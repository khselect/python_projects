# 복사: cp .env.example .env  (.env는 커밋하지 않음)
# 1이면 합성 데이터로 동작 (네트워크·API 키 불필요). 실데이터 단계 전까지 1 유지
PF_OFFLINE=1
# 단독 개발용 compose의 호스트 포트 (운영은 /docker의 market-app이 8502 사용)
MARKET_DEV_PORT=8503
# 실데이터 단계에서 입력 (S0 이후)
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
# v1 AI 해설: macOS에 직접 설치한 Ollama
OLLAMA_HOST=http://host.docker.internal:11434

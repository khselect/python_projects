# 복사: cp .env.example .env  (.env는 커밋하지 않음)
# 1이면 합성 데이터로 동작 (네트워크·API 키 불필요). 실데이터 단계 전까지 1 유지
PF_OFFLINE=1
# 단독 개발용 compose의 호스트 포트 (운영은 /docker의 market-app이 8502 사용)
MARKET_DEV_PORT=8503
# 실데이터 단계에서 입력 (S0 이후)
FRED_API_KEY=
# ③ 밸류에이션 재무제표(무료 키, 하루 25회 중 20회 사용). 없으면 밸류에이션만 건너뜀
ALPHAVANTAGE_API_KEY=
# AI 해설(F20): macOS에 직접 설치한 Ollama (ollama pull gemma3:12b · gemma3:4b)
OLLAMA_HOST=http://host.docker.internal:11434
# 비우면 PF_OFFLINE=1일 때 fake(가짜 LLM), 아니면 ollama. off면 AI 해설 생략
PF_AI_BACKEND=
